{
  "name": "la-dama-de-lima",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "prepare:game": "node scripts/prepare-game.mjs",
    "dev": "npm run prepare:game && vinext dev",
